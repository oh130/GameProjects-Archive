; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deckbuild"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"
Random="*res://scripts/autoloads/random.gd"
Audio="*res://scenes/autoloads/audio.tscn"
SceneManager="*res://scenes/autoloads/scene_manager.tscn"
SubInfoLayer="*res://scenes/autoloads/sub_info_layer.tscn"
Pool="*res://scripts/autoloads/pool.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="C:/Users/Oh/Desktop/Deckbuild.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

