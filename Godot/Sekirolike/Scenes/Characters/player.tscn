[sub_resource type="GDScript" id="GDScript_t7n1y"]
script/source = "extends CharacterBody2D

@onready var sprite : Sprite2D = $Sprite2D
@onready var animation_tree : AnimationTree = $AnimationTree
@onready var state_machine : StateMachine = $StateMachine

@export var move_speed : float
@export var dash_speed : float
@export var dash_attack_speed : float

var gravity = ProjectSettings.get_setting(\"physics/2d/default_gravity\")
var dir : Vector2 = Vector2.ZERO
var view_dir : Vector2 = Vector2.RIGHT

signal flip_signal(flip_h : bool)

func _ready():
	animation_tree.active = true

func _physics_process(delta):
	if not is_on_floor():
		velocity.y += gravity * delta
	
	if dir.x != 0:
		view_dir.x = sign(dir.x)
	
	if state_machine.current_state.can_move:
		dir = Input.get_vector(\"left\", \"right\", \"up\", \"down\")	
		velocity.x = sign(dir.x) * move_speed
	elif state_machine.current_state is DashState:
		velocity = view_dir * dash_speed
	elif state_machine.current_state is DashAttackState:
		velocity = view_dir * dash_attack_speed
	else:
		velocity.x = move_toward(velocity.x, 0, 0.2 * move_speed)
	
	move_and_slide()
	update_animation()
	update_facing_dir()

func update_animation():
	animation_tree.set(\"parameters/move/blend_position\", dir.x)

func update_facing_dir():
	if not state_machine.current_state.can_flip:
		return
	
	if velocity.x < 0:
		sprite.flip_h = true
	elif velocity.x > 0:
		sprite.flip_h = false
	
	emit_signal(\"flip_signal\", sprite.flip_h)
"

