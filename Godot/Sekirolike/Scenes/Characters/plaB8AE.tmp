[sub_resource type="GDScript" id="GDScript_t7n1y"]
script/source = "extends CharacterBody2D

@onready var sprite : Sprite2D = $Sprite2D
@onready var animation_tree : AnimationTree = $AnimationTree
@onready var state_machine : StateMachine = $StateMachine

@export var speed : float
@export var roll_speed : float

var gravity = ProjectSettings.get_setting(\"physics/2d/default_gravity\")
var dir : Vector2 = Vector2.ZERO
var view_dir : float = 1
var on_roll : bool = false

signal flip_signal(flip_h : bool)

func _ready():
	animation_tree.active = true

func _physics_process(delta):
	if not is_on_floor():
		velocity.y += gravity * delta
	
	if on_roll:
		velocity.x = view_dir * roll_speed
	else:
		dir = Input.get_vector(\"left\", \"right\", \"up\", \"down\")
		if dir.x != 0 and state_machine.check_if_can_move():
			velocity.x = dir.x * speed
		else:
			velocity.x = move_toward(velocity.x, 0, 0.2 * speed)

	move_and_slide()
	update_animation()
	update_facing_dir()

func update_animation():
	animation_tree.set(\"parameters/move/blend_position\", dir.x)

func update_facing_dir():
	if not state_machine.check_if_can_flip():
		return
	
	if dir.x < 0:
		sprite.flip_h = true
		view_dir = dir.x
	elif dir.x > 0:
		sprite.flip_h = false
		view_dir = dir.x
	
	emit_signal(\"flip_signal\", sprite.flip_h)
"

